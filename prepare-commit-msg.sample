#!/bin/sh
# Instalado por pi-coauthor. Non borres a man; usa /pi-coauthor-off.
# Detección estándar de Pi: o bash tool do axente inxecta PI_SESSION_ID e PI_MODEL.
# Sen estado nin marcadores: só engade trailers nos commits que executa Pi
# (PI_SESSION_ID presente), co modelo vivo $PI_MODEL e a versión via `pi --version`.
[ -n "${PI_SESSION_ID:-}" ] || exit 0
MODEL="${PI_MODEL:-}"
[ -n "$MODEL" ] || exit 0
VERSION="$(pi --version 2>/dev/null | tr -d "[:space:]")"
[ -n "$VERSION" ] || VERSION="unknown"
MSG="$1"
if ! grep -q "^Co-authored-by: ${MODEL} <${MODEL}@pi.dev>$" "$MSG"; then
  # Liña en branco antes do primeiro trailer (convención de trailers de git)
  [ -n "$(tail -n 1 "$MSG")" ] && printf "\n" >> "$MSG"
  printf '%s\n' "Co-authored-by: ${MODEL} <${MODEL}@pi.dev>" >> "$MSG"
fi
grep -q "^Generated-By: Pi ${VERSION}$" "$MSG" || printf '%s\n' "Generated-By: Pi ${VERSION}" >> "$MSG"
exit 0